---
import { ClientRouter, fade } from 'astro:transitions';
import '@fontsource/space-mono/400.css';
import '@fontsource/space-mono/700.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
const pathname = Astro.url.pathname;
const currentPath = pathname === '/' ? '/' : pathname.replace(/\/$/, '');
const canonicalUrl = new URL(pathname, Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#18181c" />
		<link rel="icon" type="image/png" href="/images/site/favicon.png" />
		<link rel="canonical" href={canonicalUrl} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<ClientRouter />
	</head>
	<body>
		<div class="site-shell">
			<aside class="directory" data-mobile-directory aria-label="site directory" transition:name="directory" transition:animate="none">
				<nav>
					<ul id="site-directory-tree" class="tree-children">
						<li class:list={{ 'is-current': currentPath === '/' }}>
							<a class="directory-entry-with-icon" href="/" aria-current={currentPath === '/' ? 'page' : undefined}>
								<span>about me</span>
								<img src="/images/site/favicon.png" alt="" width="16" height="16" />
							</a>
						</li>
						<li class:list={{ 'is-current': currentPath === '/certifications' }}>
							<a class="directory-entry-with-icon" href="/certifications" aria-current={currentPath === '/certifications' ? 'page' : undefined}>
								<span>certifications</span>
								<img src="/images/site/certificate.png" alt="" width="16" height="16" />
							</a>
						</li>
						<li class:list={{ 'is-current': currentPath.startsWith('/blog') }}>
							<a class="directory-entry-with-icon" href="/blog" aria-current={currentPath.startsWith('/blog') ? 'page' : undefined}>
								<span>blog</span>
								<img src="/images/site/blog-icon.png" alt="" width="16" height="16" />
							</a>
						</li>
						<li class:list={{ 'is-current': currentPath === '/resume' }}>
							<a class="directory-entry-with-icon" href="/resume" aria-current={currentPath === '/resume' ? 'page' : undefined}>
								<span>resume</span>
								<img src="/images/site/resume.png" alt="" width="16" height="16" />
							</a>
						</li>
					</ul>
				</nav>
				<button
					class="directory-toggle"
					type="button"
					aria-controls="site-directory-tree"
					aria-expanded="false"
					aria-label="show directory"
				>
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path d="m6.7 9.3 5.3 5.3 5.3-5.3 1.4 1.4-6.7 6.7-6.7-6.7 1.4-1.4Z" />
					</svg>
				</button>
			</aside>

			<div class="page-view" transition:name="page-view" transition:animate={fade({ duration: '0.28s' })}>
				<slot />
			</div>
		</div>

		<div
			class="playable-character"
			data-playable-character
			aria-hidden="true"
			transition:persist="playable-character"
		>
			<img class="character-controls" src="/images/site/wasd-icon.png" alt="" />
			<span class="character-sprite" aria-hidden="true"></span>
		</div>
		<div class="autonomous-cat" data-autonomous-cat aria-hidden="true" transition:persist="autonomous-cat">
			<span class="cat-sprite" aria-hidden="true"></span>
		</div>

		<script>
			import '../scripts/wheel-navigation';
			import '../scripts/playable-character';
			import '../scripts/autonomous-cat';
			import '../scripts/mobile-directory';
		</script>
	</body>
</html>

<style is:global>
	:root { --color-accent: #2f2f57; --color-accent-text: #8585b5; background: #18181c; color-scheme: dark; font-family: "Space Mono", ui-monospace, SFMono-Regular, Consolas, monospace; }
	*, *::before, *::after { box-sizing: border-box; }
	html, body { min-height: 100%; margin: 0; background: #18181c; }
	body { min-height: 100dvh; color: #e8e8e8; font-size: 23.75px; line-height: 1.66; }
	.site-shell { display: grid; grid-template-columns: minmax(19rem, 26vw) 1fr; min-height: 100dvh; }
	.directory { position: sticky; z-index: 1; top: 0; display: flex; grid-column: 1; grid-row: 1; align-self: start; height: 100dvh; flex-direction: column; justify-content: center; gap: 2rem; padding: clamp(1.5rem, 2.5vw, 2.75rem); border-right: 1px solid #171717; }
	.kicker { margin: 0; color: var(--color-accent-text); font-size: 0.859375rem; font-weight: 500; letter-spacing: 0.14em; text-transform: lowercase; }
	.directory ul { margin: 0; padding: 0; list-style: none; }
	.tree-children { position: relative; display: grid; gap: 0.65rem; }
	.tree-children::before { position: absolute; top: 1.5rem; bottom: 1.5rem; left: 0.25rem; border-left: 1px solid #2b2b2b; content: ''; }
	.tree-children li { position: relative; padding-left: 1.3rem; }
	.tree-children li::before { position: absolute; top: 1.5rem; left: 0.25rem; width: 0.75rem; border-top: 1px solid #2b2b2b; content: ''; }
	.tree-children li:last-child::after { position: absolute; top: 1.51rem; bottom: 0; left: 0.2rem; width: 0.15rem; background: #18181c; content: ''; }
	.directory a, .directory li > span { color: #8c8c8c; font-size: 1.875rem; text-decoration: none; }
	.directory-entry-with-icon { display: inline-flex; align-items: center; gap: 0.4rem; }
	.directory-entry-with-icon img { width: 2.0625rem; height: 2.0625rem; flex: none; object-fit: contain; image-rendering: pixelated; }
	.directory a[aria-current='page'] { color: var(--color-accent-text); }
	.directory a:hover, .directory a:focus-visible { color: #fff; }
	.directory-toggle { display: none; }
	.page-view { display: grid; grid-column: 1 / -1; grid-row: 1; min-width: 0; }
	.page-content { display: grid; min-width: 0; place-items: center; padding-block: clamp(2rem, 8vw, 8rem); padding-inline: max(clamp(2rem, 8vw, 8rem), calc(max(19rem, 26vw) + 2rem)); font-size: 1.328125rem; }
	.playable-character { position: fixed; z-index: 20; bottom: 0; left: 50%; width: 3rem; height: 4rem; padding: 0; border: 0; background: transparent; pointer-events: none; transform: translateX(-50%); }
	.playable-character.is-ready { top: 0; right: auto; bottom: auto; left: 0; }
	.character-controls { position: absolute; bottom: calc(100% + 0.2rem); left: 50%; display: block; width: 5rem; height: auto; opacity: 0.82; image-rendering: pixelated; transform: translateX(-50%); transition: opacity 180ms ease, transform 180ms ease; }
	.playable-character.guide-hidden .character-controls { opacity: 0; transform: translate(-50%, 0.35rem); }
	.character-sprite { position: absolute; top: 50%; left: 50%; display: block; width: 4.5rem; height: 5rem; background-image: url('/images/site/character-sprite-sheet.png'); background-repeat: no-repeat; background-position: 0 0; background-size: 500% 300%; image-rendering: pixelated; transform: translate(-50%, -50%) scaleX(var(--character-direction, 1)); transform-origin: center; }
	.autonomous-cat { position: fixed; z-index: 19; top: 0; left: 0; display: block; width: 4.5rem; height: 4rem; overflow: hidden; pointer-events: none; transform: translate3d(0, 0, 0); }
	.cat-sprite { position: absolute; inset: 0; display: block; background-image: url('/images/site/cat-sprite-sheet-v2.png'); background-repeat: no-repeat; background-position: 0 0; background-size: 500% 400%; image-rendering: pixelated; transform: translateY(0.375rem); }
	@media (max-width: 700px) {
		.site-shell { grid-template-columns: 1fr; grid-template-rows: auto 1fr; }
		.directory { position: relative; grid-column: 1; grid-row: 1; align-self: stretch; height: auto; justify-content: flex-start; gap: 1rem; padding: 1rem 4.75rem 1rem 1.5rem; border-right: 0; border-bottom: 1px solid #171717; }
		.directory a, .directory li > span { font-size: clamp(1.35rem, 6vw, 1.625rem); }
		.directory-entry-with-icon img { width: 1.75rem; height: 1.75rem; }
		.tree-children { gap: 0.55rem; }
		.directory:not(.is-expanded) .tree-children::before,
		.directory:not(.is-expanded) .tree-children li::before,
		.directory:not(.is-expanded) .tree-children li::after { display: none; }
		.directory:not(.is-expanded) .tree-children li:not(.is-current) { display: none; }
		.directory:not(.is-expanded) .tree-children li.is-current { padding-left: 0; }
		.directory-toggle { position: absolute; top: 50%; right: 1.25rem; display: grid; width: 2.5rem; height: 2.5rem; padding: 0; border: 1px solid var(--color-accent); border-radius: 0.65rem; background: #1d1d23; color: var(--color-accent-text); cursor: pointer; place-items: center; transform: translateY(-50%); }
		.directory-toggle:hover, .directory-toggle:focus-visible { color: #fff; }
		.directory-toggle:focus-visible { outline: 2px solid var(--color-accent-text); outline-offset: 2px; }
		.directory-toggle svg { width: 1.35rem; height: 1.35rem; fill: currentColor; transition: transform 180ms ease; }
		.directory.is-expanded .directory-toggle { top: 1rem; transform: none; }
		.directory.is-expanded .directory-toggle svg { transform: rotate(180deg); }
		.page-view { grid-column: 1; grid-row: 2; }
		.page-content { place-items: start center; padding: 3rem 1.5rem; }
		.playable-character, .autonomous-cat { display: none; }
	}
	@media (hover: none) and (pointer: coarse) {
		.playable-character, .autonomous-cat { display: none; }
	}
</style>

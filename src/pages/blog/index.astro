---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);

const formatDate = (date: Date) => new Intl.DateTimeFormat('en-US', {
	month: 'long',
	year: 'numeric',
	timeZone: 'UTC',
}).format(date).toLowerCase();
---

<BaseLayout title="blog | dylan copp">
	<main class="page-content">
		<section class="blog" aria-labelledby="blog-title">
			<header>
				<p class="kicker">writing</p>
				<h1 id="blog-title">blog</h1>
			</header>

			<ul class="post-list">
				{posts.map((post) => (
					<li>
						<h2><a href={`/blog/${post.id}`}>{post.data.title}</a></h2>
						<time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
						<p>{post.data.description}</p>
					</li>
				))}
			</ul>
		</section>
	</main>
</BaseLayout>

<style>
	.blog { width: min(100%, 64rem); }
	h1, h2, p { margin-top: 0; }
	h1 { margin-bottom: 0.8rem; font-size: clamp(2.5rem, 5vw, 4.375rem); font-weight: 400; letter-spacing: -0.05em; line-height: 1; }
	.post-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; margin: 3rem 0 0; padding: 0; list-style: none; }
	.post-list li { display: flex; min-width: 0; min-height: 15rem; flex-direction: column; padding: 1.75rem; border: 1px solid var(--color-accent); border-radius: 1.25rem; background: #1d1d23; }
	h2 { margin-bottom: 0.65rem; font-size: 1.25rem; font-weight: 500; letter-spacing: -0.02em; line-height: 1.35; }
	h2 a { color: var(--color-accent-text); text-decoration-color: var(--color-accent); text-underline-offset: 0.2em; }
	h2 a:hover, h2 a:focus-visible { color: #fff; }
	time { margin-bottom: 1.25rem; color: #73737b; font-size: 0.8125rem; }
	.post-list p { margin-bottom: 0; color: #929298; font-size: 0.9375rem; line-height: 1.65; text-indent: 1.5em; }
	@media (max-width: 1450px) {
		.post-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}
	@media (max-width: 900px) {
		.post-list { grid-template-columns: 1fr; }
		.post-list li { min-height: 0; }
	}
	@media (max-width: 480px) {
		.post-list li { padding: 1.35rem; }
	}
</style>

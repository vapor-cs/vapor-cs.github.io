---
import BaseLayout from '../layouts/BaseLayout.astro';

const certifications = [
	{ name: 'comptia security+', image: '/images/certifications/security-plus.png', issued: 'june 2024', expires: 'august 2027', verificationUrl: 'https://www.credly.com/badges/6848f856-a40f-4f61-a878-652d546f388a' },
	{ name: 'comptia cybersecurity analyst+', image: '/images/certifications/cybersecurity-analyst-plus.png', issued: 'august 2024', expires: 'august 2027', verificationUrl: 'https://www.credly.com/badges/4003bf55-0694-49f8-99e5-107e333f1e38' },
	{ name: 'centri blue team level 1', image: '/images/certifications/blue-team-level-1.png', issued: 'november 2024', verificationUrl: 'https://www.credly.com/badges/ebe53cdc-4fa9-4771-8c8e-0f4892f60762' },
	{ name: 'tryhackme security analyst level 1', image: '/images/certifications/security-analyst-level-1.png', issued: 'june 2025', expires: 'june 2028', verificationUrl: 'https://www.credly.com/badges/92a35e8f-ad8b-4ea8-b9d3-01e5875fabfc' },
];
---

<BaseLayout title="certifications | dylan copp">
	<main class="page-content">
		<section class="certifications" aria-labelledby="certifications-title">
			<header>
				<p class="kicker">credentials</p>
				<h1 id="certifications-title">certifications</h1>
			</header>

			<ul class="certification-list">
				{certifications.map((certification) => (
					<li>
						<img class="certification-badge" src={certification.image} alt="" width="72" height="72" loading="lazy" />
						<div>
							<h2>{certification.name}</h2>
							<p class="certification-dates">
								<span>issued {certification.issued}</span>
								{certification.expires && <span>expires {certification.expires}</span>}
							</p>
							<a href={certification.verificationUrl} target="_blank" rel="noreferrer">verify on credly <span aria-hidden="true">↗</span></a>
						</div>
					</li>
				))}
			</ul>
		</section>
	</main>
</BaseLayout>

<style>
	.certifications { width: min(100%, 42.5rem); }
	h1, h2, p { margin-top: 0; }
	h1 { margin-bottom: 0.8rem; font-size: clamp(2.5rem, 5vw, 4.375rem); font-weight: 400; letter-spacing: -0.05em; line-height: 1; }
	.certification-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; margin: 3rem 0 0; padding: 0; list-style: none; }
	.certification-list li { display: flex; min-width: 0; flex-direction: column; padding: 1.75rem; border: 1px solid var(--color-accent); border-radius: 1.25rem; background: #1d1d23; box-shadow: 0 0.5rem 1.25rem rgb(0 0 0 / 20%); }
	.certification-list li > div { display: flex; flex: 1; flex-direction: column; }
	.certification-badge { display: block; width: 8rem; height: 8rem; margin: 0 auto 1.5rem; object-fit: contain; image-rendering: pixelated; }
	h2 { margin-bottom: 0.5rem; color: var(--color-accent-text); font-size: 1.25rem; font-weight: 500; letter-spacing: -0.02em; }
	.certification-list p { max-width: 34rem; margin-bottom: 0.75rem; color: #8c8c8c; font-size: 1.09375rem; }
	.certification-dates { display: grid; gap: 0.1rem; }
	.certification-list a { align-self: flex-start; margin-top: auto; color: var(--color-accent-text); font-size: 0.9375rem; text-decoration-color: var(--color-accent); text-underline-offset: 0.25em; }
	.certification-list a:hover, .certification-list a:focus-visible { color: #fff; }
	@media (max-width: 1050px) {
		.certification-list { grid-template-columns: 1fr; }
	}
	@media (max-width: 480px) {
		.certification-list li { padding: 1.35rem; }
		.certification-badge { width: 6.5rem; height: 6.5rem; }
	}
</style>
